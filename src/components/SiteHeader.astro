---
const isLocal = import.meta.env.DEV;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Home">Your Name</a>
    <nav aria-label="Main navigation">
      <a href="/writing/">Writing</a>
      <a href="/#work">Work</a>
      <a href="/#about">About</a>
    </nav>
    {isLocal && <span class="local-badge">Local preview</span>}
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: center;
    min-height: 4.5rem;
  }

  .wordmark {
    justify-self: start;
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.6rem;
    font-size: 0.78rem;
  }

  nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
  }

  .local-badge {
    justify-self: end;
  }

  @media (max-width: 42rem) {
    .header-inner {
      grid-template-columns: 1fr auto;
      gap: 1rem;
    }

    nav {
      gap: 1rem;
    }

    .local-badge {
      display: none;
    }
  }
</style>
